# Copy to .env and fill in. Used by the MCP server and the probe.
# Never commit the filled-in file.

# --- direct connection ---
DS_NOTE_HOST=192.168.1.10
DS_NOTE_PORT=5001
DS_NOTE_HTTPS=true
# DS_NOTE_INSECURE=1        # accept a self-signed certificate (off by default, including for a bare IP)

# --- or a list, tried in order, with QuickConnect as the fallback ---
# DS_NOTE_HOSTS=192.168.1.10,100.64.0.5
# DS_NOTE_QUICKCONNECT=mynas

# --- or QuickConnect only ---
# DS_NOTE_QUICKCONNECT=mynas

# --- certificate ---
# DS_NOTE_CERTIFICATE_NAME=nas.example.com   # verify by name when dialling an IP
# DS_NOTE_CERTIFICATE=/path/to/nas.crt        # or verify against an exported file

# --- account ---
DS_NOTE_ACCOUNT=dsnotes
DS_NOTE_PASSWORD=

# --- optional ---
# DS_NOTE_OTP=123456          # two-factor, when no trusted device is stored yet
# DS_NOTE_DEVICE_ID=          # a previously issued device token
# DS_NOTE_TIMEOUT=20000
# DS_NOTE_ALLOW_PURGE=0       # permanent deletion stays off
# DS_NOTE_ALLOW_RAW=0         # the raw API tool stays off
